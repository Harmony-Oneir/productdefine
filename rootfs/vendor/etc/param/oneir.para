# Отладочный режим: hdcd без проверки ключа компьютера
const.secure=0
bootevent.samgr.ready=samgr:samgr:0775
# hdcd по сети вместо USB
persist.hdc.mode.tcp=enable
persist.hdc.mode.usb=disable
persist.hdc.port=8710
# Общий режим hdcd. В сборке с HDC_EMULATOR пустое значение означает режим моста
# (подключение через устройство эмулятора), и TCP выключается
persist.hdc.mode=tcp
